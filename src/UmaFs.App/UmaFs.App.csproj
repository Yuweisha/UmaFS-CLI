<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>umafs</AssemblyName>
    <RootNamespace>UmaFs.App</RootNamespace>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- winfsp 的 CheckVersion 用 Assembly.Location 取自身版本；单文件不解包时该值为空会抛异常，
         必须整体解压到临时目录，让托管 DLL 也落到磁盘上 -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="winfsp.net" Version="2.1.25156" />
  </ItemGroup>
  <ItemGroup>
    <!-- WinFsp 安装包随程序内嵌，挂载前若检测到未安装则静默安装 -->
    <EmbeddedResource Include="Resources\winfsp-2.1.25156.msi" LogicalName="winfsp.msi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\UmaFs.Core\UmaFs.Core.csproj" />
    <ProjectReference Include="..\UmaFs.Assets\UmaFs.Assets.csproj" />
  </ItemGroup>
</Project>
